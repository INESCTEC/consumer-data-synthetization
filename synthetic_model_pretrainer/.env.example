# Copy to .env and fill in - .env is git-ignored, this file is not, so never
# put a real meter identifier here.
#
#   cp .env.example .env

# Every known device_id, comma-separated. fetch_raw.py pulls all of these when
# --device-ids is not passed, and train.py's --all-fetched picks up whatever
# they produced.
PRETRAIN_DEVICE_IDS=device-a,device-b,device-c

# What `python train.py` trains when --device-ids is not passed. Keep it short:
# one model is trained per id/parameter pair, and a full fleet run takes hours.
PRETRAIN_RUN_DEVICE_IDS=device-a

# Upstream Sentinel/VCPES host that fetch_raw.py reads from. Mirrors
# services/data_provision/config.py.
VCPES_HOST=
VCPES_PORT=8000

# Bearer token for that host. Shared with the platform services, so it can live
# in services/.env or the repo-root .env instead of here.
# SENTINEL_V08_TOKEN=
